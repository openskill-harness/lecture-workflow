# 오늘 만드는 건 둘뿐 — 나머지는 준비 완료. 지금은 받을 문이 없어 404.
direction: right

classes: {
  input: { shape: rectangle; style: { fill: "#f0f0f0"; stroke: black; stroke-width: 1; border-radius: 8 } }
  proc: { shape: rectangle; style: { fill: white; stroke: black; stroke-width: 1; border-radius: 8 } }
  group: { shape: rectangle; style: { fill: transparent; stroke: black; stroke-width: 2; border-radius: 8; stroke-dash: 5 } }
}

client: "HTTP 클라이언트\nPOST /members" { class: input }

app: "회원 가입 애플리케이션" {
  class: group
  door: "① MemberController\n(문 — 오늘 만듦)" { class: proc }
  kitchen: "② MemberService\n(가입 규칙 — 오늘 만듦)" { class: proc }
  ready: "이미 준비됨\nMember · Repository · DTO" { class: proc }

  door -> kitchen: "위임" { style.stroke: "#222222" }
  kitchen -> ready: "save / existsByEmail" { style.stroke: "#222222" }
}

client -> app.door: "지금은 문이 없어 404" { style.stroke: "#222222" }
